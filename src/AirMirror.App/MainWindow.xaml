<Window x:Class="AirMirror.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MirrorSpeaker" Width="940" Height="720" MinWidth="790" MinHeight="620"
        Icon="Assets/MirrorSpeaker.ico"
        Background="{StaticResource PageBrush}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Activated="Window_Activated" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="28,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Image Width="42" Height="42" Margin="0,0,12,0"
                           Source="Assets/MirrorSpeaker.png" Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MirrorSpeaker" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock Text="Bluetooth audio and AirPlay screen mirroring for Windows" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" x:Name="StatusBadge" Background="#FFF4E5" CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#E68A00" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusBadgeText" Text="Checking setup" Foreground="#8C5500" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,24,28,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Receiver" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="ReceiverSummaryText" Text="Preparing your PC…" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,18" TextWrapping="Wrap" />

                        <StackPanel x:Name="AirPlayIdentityPanel">
                            <TextBlock Text="Name shown on your iPhone" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,7" />
                            <TextBox x:Name="DeviceNameTextBox" MaxLength="48" TextChanged="Settings_Changed" />
                        </StackPanel>

                        <TextBlock Text="What do you want to receive?" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,7" />
                        <ComboBox x:Name="ReceiverModeComboBox" Height="38" Padding="10,5" SelectionChanged="ReceiverModeComboBox_SelectionChanged">
                            <ComboBoxItem Content="AirPlay" />
                            <ComboBoxItem Content="Bluetooth speaker — best for TikTok" />
                        </ComboBox>
                        <TextBlock x:Name="ReceiverModeDescriptionText" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />

                        <StackPanel Margin="0,12,0,13">
                            <StackPanel x:Name="AirPlayOptionsPanel">
                                <CheckBox x:Name="RequirePinCheckBox" Content="Require a pairing code for new iPhones" IsChecked="True" Checked="Settings_Changed" Unchecked="Settings_Changed" />
                                <StackPanel x:Name="MirroringOptionsPanel">
                                    <CheckBox x:Name="LowLatencyCheckBox" Content="Low-latency mode for responsive mirroring" IsChecked="True" Checked="Settings_Changed" Unchecked="Settings_Changed" />
                                    <CheckBox x:Name="FullscreenCheckBox" Content="Open the mirrored screen full screen" Checked="Settings_Changed" Unchecked="Settings_Changed" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="BluetoothOptionsPanel" Visibility="Collapsed">
                                <TextBlock Text="iPhone detected by Windows" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,7" />
                                <ComboBox x:Name="BluetoothDeviceComboBox" Height="38" Padding="10,5"
                                          SelectionChanged="BluetoothDeviceComboBox_SelectionChanged" />
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="RefreshBluetoothDevicesButton" Content="Refresh phones"
                                            Style="{StaticResource SecondaryButtonStyle}" Height="34" Click="RefreshBluetoothDevicesButton_Click" />
                                    <Button Grid.Column="2" x:Name="OpenBluetoothSettingsButton" Content="Bluetooth settings"
                                            Style="{StaticResource SecondaryButtonStyle}" Height="34" Click="OpenBluetoothSettingsButton_Click" />
                                </Grid>
                                <TextBlock x:Name="BluetoothDeviceHelpText" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                           Margin="0,7,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="PrimaryButton" Content="Start receiver" Style="{StaticResource PrimaryButtonStyle}" Click="PrimaryButton_Click" />
                            <Button Grid.Column="2" x:Name="FirewallButton" Content="Allow through firewall" Style="{StaticResource SecondaryButtonStyle}" Click="FirewallButton_Click" />
                        </Grid>

                        <StackPanel x:Name="InstallProgressPanel" Visibility="Collapsed" Margin="0,16,0,0">
                            <ProgressBar x:Name="InstallProgressBar" Height="6" Minimum="0" Maximum="100" Value="0" BorderThickness="0" />
                            <TextBlock x:Name="InstallProgressText" Text="Installing receiver engine…" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" FontSize="12" />
                        </StackPanel>

                        <Border x:Name="PairingCard" Visibility="Collapsed" Background="#EEF4FF" CornerRadius="10" Margin="0,16,0,0" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Pairing code" Foreground="#34518A" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="Enter this on your iPhone" Foreground="#506B9F" FontSize="12" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="PairingCodeText" Text="••••" Foreground="#244FAD" FontWeight="Bold" FontSize="28" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Connect your iPhone" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="InstructionConnectionRequirementText" Text="Keep your iPhone and PC on the same Wi-Fi network." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,18" TextWrapping="Wrap" />

                        <Grid Margin="0,1,0,17">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="14" Background="#EAF0FF" VerticalAlignment="Top">
                                <TextBlock Text="1" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="InstructionStepOneTitleText" Text="Start the receiver" FontWeight="SemiBold" />
                                <TextBlock x:Name="InstructionStepOneDetailText" Text="Wait until the status says Ready." Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,17">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="14" Background="#EAF0FF" VerticalAlignment="Top">
                                <TextBlock Text="2" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="InstructionStepTwoTitleText" Text="Open Control Center" FontWeight="SemiBold" />
                                <TextBlock x:Name="InstructionStepTwoDetailText" Text="Swipe down from the top-right corner." Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="14" Background="#EAF0FF" VerticalAlignment="Top">
                                <TextBlock Text="3" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="InstructionStepThreeTitleText" Text="Tap Screen Mirroring" FontWeight="SemiBold" />
                                <TextBlock x:Name="InstructionDeviceNameText" Text="Choose “MirrorSpeaker on this PC”." Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Border x:Name="InstructionNoteBorder" Background="#FFF8E8" BorderBrush="#F5E2B6" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,19,0,0">
                            <TextBlock x:Name="InstructionNoteText" Text="Some protected streaming video cannot be mirrored. Your iPhone screen, photos, presentations, games, and most apps work normally." Foreground="#765A1B" FontSize="12" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CardStyle}" Padding="0" Margin="0,20,0,0">
                    <Expander x:Name="DiagnosticsExpander">
                        <Expander.Header>
                            <StackPanel Margin="20,14">
                                <TextBlock Text="Diagnostics" FontWeight="SemiBold" />
                                <TextBlock x:Name="DiagnosticsSummaryText" Text="Receiver log and troubleshooting details" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            </StackPanel>
                        </Expander.Header>
                        <Grid Margin="20,0,20,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="130" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="EnvironmentText" Text="Engine: checking…" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <TextBox Grid.Row="1" x:Name="LogTextBox" Height="Auto" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="11.5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Copy log" Style="{StaticResource SecondaryButtonStyle}" Height="34" Click="CopyLogButton_Click" />
                                <Button x:Name="OpenSettingsButton" Content="Open network settings" Style="{StaticResource SecondaryButtonStyle}" Height="34" Margin="8,0,0,0" Click="OpenNetworkSettingsButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Expander>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
